local config = require("main.modules.config")

function init(self)
	go.set("#outline", "tint", config.COLOR_OUTLINE)
	go.set("#eye_l_white", "tint", vmath.vector4(1.0, 1.0, 1.0, 1.0))
	go.set("#eye_r_white", "tint", vmath.vector4(1.0, 1.0, 1.0, 1.0))
	go.set("#eye_l_pupil", "tint", vmath.vector4(0.06, 0.08, 0.12, 1.0))
	go.set("#eye_r_pupil", "tint", vmath.vector4(0.06, 0.08, 0.12, 1.0))
end

function on_message(self, message_id, message, sender)
	if message_id == hash("set_tint") then
		if message.tint then
			go.set("#sprite", "tint", message.tint)
		end
		if message.is_enemy then
			go.set_position(vmath.vector3(-1.8, -1.2, 0.04), "#eye_l_white")
			go.set_position(vmath.vector3(1.8, -1.2, 0.04), "#eye_r_white")
			go.set_position(vmath.vector3(-1.8, -1.8, 0.06), "#eye_l_pupil")
			go.set_position(vmath.vector3(1.8, -1.8, 0.06), "#eye_r_pupil")
		end
	end
end
