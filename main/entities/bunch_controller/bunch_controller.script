-- Squad view: spawns warrior sprites in a readable formation and animates the crowd.
-- No game logic here: battle_state decides, this script only shows.
local config = require("main.modules.config")

local WHITE = vmath.vector4(1, 1, 1, 1)
local SHADOW = vmath.vector4(0, 0, 0, 0.32)
local GOLD = vmath.vector4(1.0, 0.82, 0.2, 1)
local MAX_LURCHERS = 14 -- warriors animated per strike (keeps big crowds cheap)

local function sprite_url(id)
	return msg.url(nil, id, "sprite")
end

local function set_badge_visible(self, visible)
	local enemy = (self.team == config.TEAM_ENEMY)
	msg.post("#badge", (visible and not enemy) and "enable" or "disable")
	msg.post("#tier_label", (visible and not enemy) and "enable" or "disable")
	msg.post("#badge_e", (visible and enemy) and "enable" or "disable")
	msg.post("#tier_label_e", (visible and enemy) and "enable" or "disable")
end

local function clear_warriors(self)
	for i = 1, #self.warriors do
		local w = self.warriors[i]
		if go.exists(w.id) then go.delete(w.id) end
	end
	self.warriors = {}
end

local function setup_visuals(self, data)
	clear_warriors(self)

	self.team = data.team or config.TEAM_PLAYER
	self.unit_type = data.unit_type
	self.tier = data.tier or 1
	self.is_boss = data.is_boss
	local is_enemy = (self.team == config.TEAM_ENEMY)

	if is_enemy then
		self.base_tint = (data.unit_type == config.UNIT_ARCHER) and config.COLOR_ENEMY_ARCHER or config.COLOR_ENEMY_MELEE
	else
		self.base_tint = (data.unit_type == config.UNIT_ARCHER) and config.COLOR_PLAYER_ARCHER or config.COLOR_PLAYER_MELEE
	end

	-- Tier identity: ring + badge color, number on the badge
	self.ring_tint = config.get_tier_color(self.tier)
	go.set("#base_ring", "tint", self.ring_tint)
	go.set("#badge", "tint", self.ring_tint)
	go.set("#badge_e", "tint", self.ring_tint)
	go.set("#shadow", "tint", SHADOW)
	go.set("#tier_label", "text", tostring(self.tier))
	go.set("#tier_label_e", "text", tostring(self.tier))
	set_badge_visible(self, true)
	msg.post("#buff_ring", "disable")
	if self.is_boss then
		msg.post("#crown", "enable")
		go.set("#crown", "tint", GOLD)
	else
		msg.post("#crown", "disable")
	end

	local count = data.unit_count or config.get_unit_count(self.tier)
	local offsets = config.get_formation_offsets(count)
	local scale = config.get_warrior_scale(count) * (self.is_boss and 1.2 or 1.0)
	-- Very high tiers grow slightly once the crowd size is capped
	if self.tier > #config.UNIT_COUNTS then
		scale = scale * math.min(1.3, 1 + (self.tier - #config.UNIT_COUNTS) * 0.02)
	end
	self.warrior_scale = vmath.vector3(scale, scale, 1)
	self.base_rot = is_enemy and math.pi or 0
	local flip = is_enemy and -1 or 1

	local factory_url = (data.unit_type == config.UNIT_ARCHER) and "#archer_factory" or "#melee_factory"
	local my_id = go.get_id()
	for i = 1, #offsets do
		local o = offsets[i]
		local off = vmath.vector3(o.x, o.y * flip, o.z)
		local w_id = factory.create(factory_url, nil, nil, nil, self.warrior_scale)
		go.set_parent(w_id, my_id, false)
		go.set_position(off, w_id)
		go.set_rotation(vmath.quat_rotation_z(self.base_rot), w_id)
		go.set(sprite_url(w_id), "tint", self.base_tint)
		table.insert(self.warriors, {
			id = w_id,
			url = sprite_url(w_id),
			base_offset = off,
			phase = math.random() * math.pi * 2,
			speed = 2.0 + math.random() * 1.5,
			alive = true,
			chaos = 0.8 + math.random() * 0.9,
			flank = (o.x > 2 and 1) or (o.x < -2 and -1) or 0,
		})
	end
	self.alive_count = #self.warriors

	local pos = data.pos or data.home_pos
	if pos then
		go.set_position(vmath.vector3(pos.x, pos.y, 0))
		self.last_pos = vmath.vector3(pos)
	end

	go.cancel_animations(".", "scale")
	if data.is_merge then
		go.set_scale(vmath.vector3(1.45, 0.6, 1))
		go.animate(".", "scale", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(1, 1, 1), go.EASING_OUTELASTIC, 0.5)
	else
		go.set_scale(vmath.vector3(0.2, 0.2, 1))
		go.animate(".", "scale", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(1, 1, 1), go.EASING_OUTBACK, 0.28)
	end
end

local FLASH_COOLDOWN = 0.35 -- hits arrive every frame in big fights; keep team colors readable

local function flash(self, tint, duration)
	if self.flash_timer > 0 or self.flash_cd > 0 then return end
	self.flash_timer = duration or 0.06
	self.flash_cd = FLASH_COOLDOWN
	for i = 1, #self.warriors do
		local w = self.warriors[i]
		if w.alive then go.set(w.url, "tint", tint or WHITE) end
	end
end

local function kill_warrior(self, w)
	if not w.alive then return end
	w.alive = false
	if not go.exists(w.id) then return end
	-- Fling backwards with a spin and fade out
	local back = (self.team == config.TEAM_PLAYER) and -1 or 1
	local p = go.get_position(w.id)
	local target = vmath.vector3(p.x + (math.random() - 0.5) * 22, p.y + back * (8 + math.random() * 14), p.z)
	go.cancel_animations(w.id, "position")
	go.animate(w.id, "position", go.PLAYBACK_ONCE_FORWARD, target, go.EASING_OUTQUAD, 0.32)
	go.animate(w.id, "euler.z", go.PLAYBACK_ONCE_FORWARD, (math.random() > 0.5 and 1 or -1) * 300, go.EASING_OUTQUAD, 0.32)
	go.set(w.url, "tint", vmath.vector4(1, 1, 1, 1))
	go.animate(w.url, "tint", go.PLAYBACK_ONCE_FORWARD, vmath.vector4(0.3, 0.3, 0.35, 0), go.EASING_INQUAD, 0.32, 0, function()
		if not w.alive and go.exists(w.id) then
			msg.post(w.id, "disable")
		end
	end)
end

local function revive_warrior(self, w)
	w.alive = true
	if not go.exists(w.id) then return end
	go.cancel_animations(w.id, "position")
	go.cancel_animations(w.id, "euler.z")
	go.cancel_animations(w.url, "tint")
	msg.post(w.id, "enable")
	go.set(w.url, "tint", self.base_tint)
	go.set_position(w.base_offset, w.id)
	go.set_rotation(vmath.quat_rotation_z(self.base_rot), w.id)
	go.set_scale(vmath.vector3(0.01, 0.01, 1), w.id)
	go.animate(w.id, "scale", go.PLAYBACK_ONCE_FORWARD, self.warrior_scale, go.EASING_OUTBACK, 0.25)
end

local function replenish_all(self, data)
	local pos = data and (data.pos or data.home_pos)
	go.cancel_animations(".", "position")
	go.cancel_animations(".", "scale")
	if pos then
		go.set_position(vmath.vector3(pos.x, pos.y, 0))
		self.last_pos = vmath.vector3(pos)
	end
	go.set_scale(vmath.vector3(1, 1, 1))
	self.is_moving = false
	for i = 1, #self.warriors do
		local w = self.warriors[i]
		if not w.alive then
			revive_warrior(self, w)
		elseif go.exists(w.id) then
			go.set(w.url, "tint", self.base_tint)
			go.set_position(w.base_offset, w.id)
			go.set_rotation(vmath.quat_rotation_z(self.base_rot), w.id)
		end
	end
	self.alive_count = #self.warriors
	self.in_battle = false
	set_badge_visible(self, true)
	go.set("#base_ring", "tint", self.ring_tint)
	msg.post("#buff_ring", "disable")
end

local function update_combat_visuals(self, data)
	if data.pos then
		local dx = data.pos.x - self.last_pos.x
		local dy = data.pos.y - self.last_pos.y
		self.is_moving = (dx * dx + dy * dy) > 0.02
		self.last_pos = vmath.vector3(data.pos)
		go.set_position(vmath.vector3(data.pos.x, data.pos.y, 0))
	end

	if not self.in_battle then
		self.in_battle = true
		set_badge_visible(self, false)
		local r = self.ring_tint
		go.set("#base_ring", "tint", vmath.vector4(r.x, r.y, r.z, 0.45))
	end

	-- Visible warriors follow HP: back ranks fall first
	local target_alive = data.alive_units or self.alive_count
	if target_alive < self.alive_count then
		for i = #self.warriors, target_alive + 1, -1 do
			kill_warrior(self, self.warriors[i])
		end
		self.alive_count = target_alive
	end
end

local function play_attack_lurch(self, target_pos)
	local my_pos = go.get_position()
	local dx, dy = target_pos.x - my_pos.x, target_pos.y - my_pos.y
	local dist = math.sqrt(dx * dx + dy * dy)
	if dist <= 0.1 then return end
	dx, dy = dx / dist, dy / dist

	local n = 0
	for i = 1, #self.warriors do
		local w = self.warriors[i]
		if w.alive and math.random() < 0.6 then
			n = n + 1
			local b = w.base_offset
			local lunge = 5 + math.random() * 5
			local to = vmath.vector3(b.x + dx * lunge, b.y + dy * lunge, b.z)
			w.lunging = true
			go.animate(w.id, "position", go.PLAYBACK_ONCE_PINGPONG, to, go.EASING_OUTQUAD, 0.16, (i % 4) * 0.03, function()
				w.lunging = false
			end)
			if n >= MAX_LURCHERS then break end
		end
	end
end

local function set_buff(self, buff, on)
	if not on then
		msg.post("#buff_ring", "disable")
		return
	end
	msg.post("#buff_ring", "enable")
	local tint = vmath.vector4(0.3, 0.7, 1.0, 0.8)
	if buff == "fire" then
		tint = vmath.vector4(1.0, 0.5, 0.05, 0.85)
	elseif buff == "rage" then
		tint = vmath.vector4(1.0, 0.2, 0.35, 0.85)
	end
	go.set("#buff_ring", "tint", tint)
	go.cancel_animations("#buff_ring", "scale")
	go.set("#buff_ring", "scale", vmath.vector3(1.0, 1.0, 1))
	go.animate("#buff_ring", "scale", go.PLAYBACK_LOOP_PINGPONG, vmath.vector3(1.25, 1.25, 1), go.EASING_INOUTSINE, 0.6)
	flash(self, tint, 0.12)
end

local function set_hint(self, active, color)
	go.cancel_animations(".", "scale")
	if active then
		go.animate(".", "scale", go.PLAYBACK_LOOP_PINGPONG, vmath.vector3(1.14, 1.14, 1), go.EASING_INOUTSINE, 0.28)
		go.set("#base_ring", "tint", color or config.COLOR_CELL_MERGE)
	else
		go.set_scale(vmath.vector3(1, 1, 1))
		go.set("#base_ring", "tint", self.ring_tint or config.get_tier_color(1))
	end
end

function init(self)
	self.warriors = {}
	self.alive_count = 0
	self.time = math.random() * 10
	self.last_pos = vmath.vector3()
	self.is_moving = false
	self.flash_timer = 0
	self.flash_cd = 0
	msg.post("#buff_ring", "disable")
	msg.post("#crown", "disable")
end

function final(self)
	clear_warriors(self)
end

function update(self, dt)
	self.time = self.time + dt
	self.flash_cd = self.flash_cd - dt

	if self.flash_timer > 0 then
		self.flash_timer = self.flash_timer - dt
		if self.flash_timer <= 0 then
			for i = 1, #self.warriors do
				local w = self.warriors[i]
				if w.alive then go.set(w.url, "tint", self.base_tint) end
			end
		end
	end

	local fwd = (self.team == config.TEAM_PLAYER) and 1 or -1
	local t = self.time
	-- Rotation only changes while marching; reset it once when the squad stops
	local reset_rot = (not self.is_moving) and self.was_moving
	self.was_moving = self.is_moving
	for i = 1, #self.warriors do
		local w = self.warriors[i]
		if w.alive and not w.lunging then
			local b = w.base_offset
			local ox, oy, rot
			if self.is_moving then
				-- Marching crowd: bounce, waddle, spread to the flanks, vanguard surges ahead
				local step = math.sin(t * 15 + w.phase)
				ox = b.x + w.flank * 3 + math.sin(t * 9 + w.phase) * w.chaos
				oy = b.y + fwd * 3 + math.abs(step) * 2.2 + math.cos(t * 10 + w.phase) * w.chaos
				rot = self.base_rot + step * 0.18
			else
				ox = b.x + math.cos(t * w.speed * 0.8 + w.phase) * 0.4
				oy = b.y + math.sin(t * w.speed + w.phase) * 0.7
				rot = reset_rot and self.base_rot or nil
			end
			go.set_position(vmath.vector3(ox, oy, b.z), w.id)
			if rot then
				go.set_rotation(vmath.quat_rotation_z(rot), w.id)
			end
		end
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("setup") then
		setup_visuals(self, message)
	elseif message_id == hash("replenish") then
		replenish_all(self, message)
	elseif message_id == hash("update_visual") then
		update_combat_visuals(self, message)
	elseif message_id == hash("hit") then
		-- soft flash: team color pushed towards white, keeps sides readable
		local c = self.base_tint
		flash(self, vmath.vector4(c.x + (1 - c.x) * 0.55, c.y + (1 - c.y) * 0.55, c.z + (1 - c.z) * 0.55, 1), 0.05)
	elseif message_id == hash("attack") then
		play_attack_lurch(self, message.target_pos)
	elseif message_id == hash("snap") then
		local pos = message.pos
		go.cancel_animations(".", "position")
		go.animate(".", "position", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(pos.x, pos.y, 0), go.EASING_OUTBACK, 0.16)
		go.cancel_animations(".", "scale")
		go.animate(".", "scale", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(1, 1, 1), go.EASING_OUTBACK, 0.16)
	elseif message_id == hash("drag_state") then
		go.cancel_animations(".", "scale")
		local p = go.get_position()
		p.z = message.dragging and 0.75 or 0
		go.set_position(p)
		local s = message.dragging and 1.28 or 1.0
		go.animate(".", "scale", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(s, s, 1), go.EASING_OUTBACK, 0.12)
	elseif message_id == hash("merge_hint") then
		set_hint(self, message.active, config.COLOR_CELL_MERGE)
	elseif message_id == hash("card_hint") then
		set_hint(self, message.active, message.color)
	elseif message_id == hash("buff") then
		set_buff(self, message.buff, message.on)
	end
end
