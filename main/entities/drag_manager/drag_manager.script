local config = require("main.modules.config")
local grid = require("main.modules.grid")
local battle_state = require("main.modules.battle_state")
local tutorial = require("main.modules.tutorial")
local poki = require("main.modules.poki")
local cards = require("main.modules.cards")

local camera = nil
pcall(function()
	camera = require("orthographic.camera")
end)

function init(self)
	msg.post(".", "acquire_input_focus")
	self.dragging = false
	self.drag_item = nil
	self.drag_type = nil
	self.drag_r = nil
	self.drag_c = nil
	self.camera_id = hash("/camera")
end

function final(self)
	msg.post(".", "release_input_focus")
end

local function get_world_pos(self, action)
	local sx = action.screen_x or action.x
	local sy = action.screen_y or action.y
	if camera and camera.screen_to_world then
		return camera.screen_to_world(self.camera_id, vmath.vector3(sx, sy, 0))
	end
	return vmath.vector3(action.x, action.y, 0)
end

function on_input(self, action_id, action)
	if action_id ~= hash("touch") then return false end

	poki.on_player_input()

	local phase = battle_state.get_phase()
	if phase ~= config.PHASE_PREP then
		if self.dragging then
			self.dragging = false
			self.drag_item = nil
			self.drag_type = nil
		end
		return false
	end

	local world_pos = get_world_pos(self, action)

	if action.pressed then
		if not tutorial.is_merge_allowed() then
			return false
		end

		local r, c = grid.world_to_player_cell(world_pos.x, world_pos.y)
		if r and c then
			local item = grid.get_player_item(r, c)
			if item and item.go_id and go.exists(item.go_id) then
				if item.is_crate then
					-- Tap wooden crate to crack it open into a random card!
					battle_state.open_crate(item)
					return true
				elseif item.is_card then
					-- Pick up card to drag
					self.dragging = true
					self.drag_item = item
					self.drag_type = "card"
					self.drag_r = r
					self.drag_c = c
					go.cancel_animations(item.go_id, "position")
					go.set_position(vmath.vector3(world_pos.x, world_pos.y + 24, 10.0), item.go_id)
					msg.post(item.go_id, "drag_state", { dragging = true })

					-- Highlight compatible squads on field with card glow!
					local cinfo = cards.CARD_INFO[item.card_type]
					local glow_col = cinfo and cinfo.glow_color or vmath.vector4(1.0, 0.85, 0.2, 1.0)
					local all_player = battle_state.get_player_squads()
					for _, target in ipairs(all_player) do
						if cards.can_apply(item.card_type, target) and target.go_id and go.exists(target.go_id) then
							msg.post(target.go_id, "card_hint", { active = true, color = glow_col })
						end
					end
					return true
				else
					-- Pick up squad to drag
					self.dragging = true
					self.drag_item = item
					self.drag_type = "squad"
					self.drag_r = r
					self.drag_c = c
					go.cancel_animations(item.go_id, "position")
					go.set_position(vmath.vector3(world_pos.x, world_pos.y + 24, 10.0), item.go_id)
					msg.post(item.go_id, "drag_state", { dragging = true })

					-- Highlight matching merge pairs on field with golden pulse!
					local all_player = battle_state.get_player_squads()
					for _, other in ipairs(all_player) do
						if other.id ~= item.id and other.unit_type == item.unit_type and other.tier == item.tier and other.go_id and go.exists(other.go_id) then
							msg.post(other.go_id, "merge_hint", { active = true })
						end
					end
					return true
				end
			end
		end
	elseif action.released then
		if self.dragging and self.drag_item then
			self.dragging = false
			local item = self.drag_item
			local drag_type = self.drag_type
			local start_r = self.drag_r
			local start_c = self.drag_c
			self.drag_item = nil
			self.drag_type = nil
			self.drag_r = nil
			self.drag_c = nil

			-- Stop any active hints on squads
			local all_player = battle_state.get_player_squads()
			for _, other in ipairs(all_player) do
				if other.go_id and go.exists(other.go_id) then
					msg.post(other.go_id, "merge_hint", { active = false })
					msg.post(other.go_id, "card_hint", { active = false })
				end
			end

			if item.go_id and go.exists(item.go_id) then
				msg.post(item.go_id, "drag_state", { dragging = false })
			end

			local target_r, target_c = grid.world_to_player_cell(world_pos.x, world_pos.y)
			local handled = false

			if drag_type == "card" then
				if target_r and target_c then
					handled = battle_state.move_card(item, target_r, target_c)
				end
				if not handled and item.go_id and go.exists(item.go_id) then
					go.cancel_animations(item.go_id, "position")
					go.animate(item.go_id, "position", go.PLAYBACK_ONCE_FORWARD, item.home_pos, go.EASING_OUTQUAD, 0.12)
				end
			elseif drag_type == "squad" then
				if target_r and target_c and (target_r ~= start_r or target_c ~= start_c) then
					handled = battle_state.move_squad(start_r, start_c, target_r, target_c)
				end
				if not handled and item.go_id and go.exists(item.go_id) then
					go.cancel_animations(item.go_id, "position")
					go.animate(item.go_id, "position", go.PLAYBACK_ONCE_FORWARD, item.home_pos, go.EASING_OUTQUAD, 0.12)
				end
			end

			return true
		end
	else
		-- Dragging motion: float 24px above finger so player clearly sees what they hold
		if self.dragging and self.drag_item and self.drag_item.go_id and go.exists(self.drag_item.go_id) then
			go.set_position(vmath.vector3(world_pos.x, world_pos.y + 24, 10.0), self.drag_item.go_id)
			return true
		end
	end

	return false
end
