-- Renders the pure-Lua arrow pool (main/modules/projectiles.lua) onto pooled sprites.
local config = require("main.modules.config")
local projectiles = require("main.modules.projectiles")

local FACTORY_URL = "#projectile_factory"
local HIDDEN = vmath.vector3(0, -3000, 0)

function init(self)
	self.sprites = {}
	local pool = projectiles.get_pool()
	for i = 1, #pool do
		local id = factory.create(FACTORY_URL, HIDDEN)
		self.sprites[i] = { id = id, url = msg.url(nil, id, "sprite"), version = -1, shown = false }
	end
end

function final(self)
	for i = 1, #self.sprites do
		if go.exists(self.sprites[i].id) then go.delete(self.sprites[i].id) end
	end
	self.sprites = {}
end

function update(self, dt)
	local pool = projectiles.get_pool()
	for i = 1, #pool do
		local p = pool[i]
		local s = self.sprites[i]
		if s then
			if p.active then
				if s.version ~= p.version then
					s.version = p.version
					local tint
					if p.is_fire then
						tint = vmath.vector4(1.0, 0.55, 0.1, 1)
					elseif p.team == config.TEAM_PLAYER then
						tint = config.COLOR_PLAYER_ARROW
					else
						tint = config.COLOR_ENEMY_ARROW
					end
					go.set(s.url, "tint", tint)
				end
				-- Arrow grows a bit at the top of its arc (fake height)
				local h = 1 + (p.lift or 0) / 90
				go.set_position(vmath.vector3(p.x, p.y, 0.5), s.id)
				go.set_rotation(vmath.quat_rotation_z(p.angle - math.pi * 0.5), s.id)
				go.set_scale(vmath.vector3(0.55 * h, 0.55 * h, 1), s.id)
				s.shown = true
			elseif s.shown then
				s.shown = false
				go.set_position(HIDDEN, s.id)
			end
		end
	end
end
