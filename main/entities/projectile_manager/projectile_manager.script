local config = require("main.modules.config")
local battle_state = require("main.modules.battle_state")

local pool = {}
local POOL_SIZE = config.PROJECTILE_POOL_SIZE or 75
local FACTORY_URL = "#projectile_factory"

local function init_pool()
	pool = {}
	for i = 1, POOL_SIZE do
		local p_id = factory.create(FACTORY_URL, vmath.vector3(0, -2000, 0))
		msg.post(p_id, "disable")
		table.insert(pool, {
			id = p_id,
			active = false,
			pos = vmath.vector3(0, -2000, 0),
			dir = vmath.vector3(0, 1, 0),
			target_point = vmath.vector3(0, 0, 0),
			target_squad = nil,
			damage = 0,
			speed = config.PROJECTILE_SPEED,
			distance_left = 0,
		})
	end
end

local function spawn_arrow(from_pos, target_squad, damage, miss_radius, is_fire)
	-- Find inactive projectile in pool
	local arrow = nil
	for i = 1, #pool do
		if not pool[i].active then
			arrow = pool[i]
			break
		end
	end
	if not arrow then return end

	-- Calculate target point with slight spread/miss potential
	local target_pos = target_squad.current_pos
	local miss_x = 0
	local miss_y = 0
	if miss_radius and miss_radius > 0 then
		local angle = math.random() * math.pi * 2
		local r = math.random() * miss_radius
		miss_x = math.cos(angle) * r
		miss_y = math.sin(angle) * r
	end

	local tx = target_pos.x + miss_x
	local ty = target_pos.y + miss_y
	local start_pos = vmath.vector3(from_pos.x, from_pos.y, 0.5)

	local dx = tx - start_pos.x
	local dy = ty - start_pos.y
	local dist = math.sqrt(dx * dx + dy * dy)
	if dist < 1 then dist = 1 end

	arrow.active = true
	arrow.pos = start_pos
	arrow.dir = vmath.vector3(dx / dist, dy / dist, 0)
	arrow.target_point = vmath.vector3(tx, ty, 0)
	arrow.target_squad = target_squad
	arrow.damage = damage
	arrow.distance_left = dist

	-- Rotation towards target
	local rot = vmath.quat_rotation_z(math.atan2(dy, dx) - math.pi * 0.5)
	go.set_rotation(rot, arrow.id)
	go.set_position(arrow.pos, arrow.id)

	-- Tint based on shooter team or fire buff
	local tint
	if is_fire then
		tint = vmath.vector4(1.0, 0.45, 0.05, 1.0)
	else
		tint = (target_squad.team == config.TEAM_ENEMY) and config.COLOR_PLAYER_ARROW or config.COLOR_ENEMY_ARROW
	end
	msg.post(arrow.id, "set_tint", { tint = tint })
	msg.post(arrow.id, "enable")
end

function init(self)
	init_pool()

	-- Register shoot handler directly into battle_state
	battle_state.set_view_handlers({
		shoot_projectile = function(shooter_squad, target_squad, damage, miss_radius, origin_pos)
			local start_pt = origin_pos or shooter_squad.current_pos
			local is_fire = (shooter_squad and shooter_squad.has_fire)
			spawn_arrow(start_pt, target_squad, damage, miss_radius, is_fire)
		end
	})
end

function final(self)
	for i = 1, #pool do
		go.delete(pool[i].id)
	end
	pool = {}
end

function update(self, dt)
	local hit_r_sq = config.PROJECTILE_HIT_RADIUS * config.PROJECTILE_HIT_RADIUS

	for i = 1, #pool do
		local p = pool[i]
		if p.active then
			local step = p.speed * dt
			p.pos = p.pos + p.dir * step
			p.distance_left = p.distance_left - step

			if p.distance_left <= 0 then
				-- Projectile reached target point
				if p.target_squad and p.target_squad.is_alive then
					local sx = p.target_squad.current_pos.x
					local sy = p.target_squad.current_pos.y
					local dx = p.pos.x - sx
					local dy = p.pos.y - sy
					local d2 = dx * dx + dy * dy
					if d2 <= hit_r_sq then
						battle_state.apply_damage(p.target_squad, p.damage)
					end
				end

				-- Deactivate & return to pool
				p.active = false
				msg.post(p.id, "disable")
				go.set_position(vmath.vector3(0, -2000, 0), p.id)
			else
				go.set_position(p.pos, p.id)
			end
		end
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("shoot") then
		spawn_arrow(message.from_pos, message.target_squad, message.damage, message.miss_radius)
	end
end
