local config = require("main.modules.config")

function init(self)
	go.set("#sprite", "tint", vmath.vector4(1, 1, 1, 1))
end

function on_message(self, message_id, message, sender)
	if message_id == hash("play") then
		local p_type = message.type or "spark"
		local tint = message.tint or vmath.vector4(1, 0.85, 0.2, 1)
		local scale = message.scale or 1.0
		local duration = message.duration or 0.25

		go.set("#sprite", "tint", tint)

		if p_type == "drum_ripple" then
			-- Drum of Rage tap ripple: expands outward quickly and fades
			go.set("#sprite", "scale", vmath.vector3(0.3, 0.3, 1.0))
			go.animate("#sprite", "scale", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(scale * 3.8, scale * 3.8, 1.0), go.EASING_OUTQUAD, duration)
			go.animate("#sprite", "tint.w", go.PLAYBACK_ONCE_FORWARD, 0.0, go.EASING_OUTQUAD, duration, 0, function()
				msg.post(".", "recycle")
			end)
		elseif p_type == "merge_ring" then
			-- Expanding shockwave ring
			go.set("#sprite", "scale", vmath.vector3(0.2, 0.2, 1.0))
			go.animate("#sprite", "scale", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(scale * 3.5, scale * 3.5, 1.0), go.EASING_OUTQUAD, duration)
			go.animate("#sprite", "tint.w", go.PLAYBACK_ONCE_FORWARD, 0.0, go.EASING_INQUAD, duration, 0, function()
				msg.post(".", "recycle")
			end)
		elseif p_type == "hit_spark" then
			-- High energy impact flash / spark that shoots out and fades
			local dir = message.dir or vmath.vector3(0, 0, 0)
			local dist = message.dist or 20
			local end_pos = go.get_position() + dir * dist
			go.set("#sprite", "scale", vmath.vector3(scale * 0.8, scale * 0.8, 1.0))
			go.animate(".", "position", go.PLAYBACK_ONCE_FORWARD, end_pos, go.EASING_OUTQUAD, duration)
			go.animate("#sprite", "scale", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(0.01, 0.01, 1.0), go.EASING_INQUAD, duration)
			go.animate("#sprite", "tint.w", go.PLAYBACK_ONCE_FORWARD, 0.0, go.EASING_INQUAD, duration, 0, function()
				msg.post(".", "recycle")
			end)
		elseif p_type == "slash_slice" then
			-- Melee slash cut visual
			local rot = message.rotation or 0
			go.set_rotation(vmath.quat_rotation_z(rot))
			go.set("#sprite", "scale", vmath.vector3(scale * 0.2, scale * 1.8, 1.0))
			go.animate("#sprite", "scale", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(scale * 0.05, scale * 2.4, 1.0), go.EASING_OUTQUAD, duration)
			go.animate("#sprite", "tint.w", go.PLAYBACK_ONCE_FORWARD, 0.0, go.EASING_INQUAD, duration, 0, function()
				msg.post(".", "recycle")
			end)
		else
			-- Standard burst particle
			local end_pos = go.get_position() + (message.dir or vmath.vector3(0, 0, 0)) * (message.dist or 15)
			go.set("#sprite", "scale", vmath.vector3(scale, scale, 1.0))
			go.animate(".", "position", go.PLAYBACK_ONCE_FORWARD, end_pos, go.EASING_OUTQUAD, duration)
			go.animate("#sprite", "scale", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(0.01, 0.01, 1.0), go.EASING_INQUAD, duration)
			go.animate("#sprite", "tint.w", go.PLAYBACK_ONCE_FORWARD, 0.0, go.EASING_INQUAD, duration, 0, function()
				msg.post(".", "recycle")
			end)
		end
	end
end
