local config = require("main.modules.config")

go.property("team", hash("player"))

function init(self)
	self.base = (self.team == hash("player")) and config.COLOR_CELL_PLAYER or config.COLOR_CELL_ENEMY
	go.set("#sprite", "tint", self.base)
end

function on_message(self, message_id, message, sender)
	local duration = message.duration or 0.2
	if message_id == hash("hide") then
		local b = self.base
		go.cancel_animations("#sprite", "tint")
		go.animate("#sprite", "tint", go.PLAYBACK_ONCE_FORWARD, vmath.vector4(b.x, b.y, b.z, 0), go.EASING_INQUAD, duration)
	elseif message_id == hash("show") then
		go.cancel_animations("#sprite", "tint")
		go.animate("#sprite", "tint", go.PLAYBACK_ONCE_FORWARD, self.base, go.EASING_OUTQUAD, duration)
	end
end
