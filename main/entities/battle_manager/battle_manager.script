	vmath.vector4(0.20, 0.85, 1.0, 1), -- Electric cyan
	vmath.vector4(0.55, 0.95, 1.0, 1), -- Ice blue
	vmath.vector4(0.10, 0.65, 1.0, 1), -- Deep azure
	vmath.vector4(1.0, 1.0, 1.0, 1),   -- Pure white
}

-- 12 distinct multi-color hit palettes for all tiers (cycles for higher tiers)
local TIER_HIT_PALETTES = {
	-- T1: Silver steel & friction gold
	{ vmath.vector4(0.95, 0.98, 1.0, 1), vmath.vector4(0.70, 0.85, 1.0, 1), vmath.vector4(1.0, 0.85, 0.35, 1), vmath.vector4(0.8, 0.9, 1.0, 1) },
	-- T2: Vibrant lime & emerald
	{ vmath.vector4(0.40, 1.0, 0.35, 1), vmath.vector4(0.20, 0.85, 0.50, 1), vmath.vector4(0.85, 1.0, 0.25, 1), vmath.vector4(1, 1, 1, 1) },
	-- T3: Electric azure & cyan
	{ vmath.vector4(0.25, 0.80, 1.0, 1), vmath.vector4(0.10, 0.98, 0.95, 1), vmath.vector4(0.50, 0.40, 1.0, 1), vmath.vector4(1, 1, 1, 1) },
	-- T4: Royal purple & fuchsia
	{ vmath.vector4(0.75, 0.35, 1.0, 1), vmath.vector4(0.95, 0.25, 0.80, 1), vmath.vector4(0.45, 0.70, 1.0, 1), vmath.vector4(1, 1, 1, 1) },
	-- T5: Radiant gold & sunlight
	{ vmath.vector4(1.0, 0.85, 0.15, 1), vmath.vector4(1.0, 0.60, 0.10, 1), vmath.vector4(1.0, 0.98, 0.55, 1), vmath.vector4(1, 1, 0.9, 1) },
	-- T6: Blazing flame & embers
	{ vmath.vector4(1.0, 0.45, 0.10, 1), vmath.vector4(1.0, 0.85, 0.20, 1), vmath.vector4(1.0, 0.15, 0.25, 1), vmath.vector4(1, 1, 1, 1) },
	-- T7: Deep ruby & rose
	{ vmath.vector4(1.0, 0.18, 0.40, 1), vmath.vector4(1.0, 0.45, 0.65, 1), vmath.vector4(1.0, 0.85, 0.30, 1), vmath.vector4(1, 1, 1, 1) },
	-- T8: High-energy cyan & turquoise
	{ vmath.vector4(0.10, 0.98, 0.92, 1), vmath.vector4(0.20, 0.70, 1.0, 1), vmath.vector4(0.40, 1.0, 0.65, 1), vmath.vector4(1, 1, 1, 1) },
	-- T9: Neon pink & magenta
	{ vmath.vector4(1.0, 0.40, 0.85, 1), vmath.vector4(1.0, 0.20, 0.55, 1), vmath.vector4(0.40, 0.85, 1.0, 1), vmath.vector4(1, 1, 1, 1) },
	-- T10: Acid lime & cyber yellow
	{ vmath.vector4(0.65, 1.0, 0.20, 1), vmath.vector4(0.95, 0.98, 0.15, 1), vmath.vector4(0.20, 1.0, 0.80, 1), vmath.vector4(1, 1, 1, 1) },
	-- T11: Prismatic diamond & violet
	{ vmath.vector4(0.95, 0.98, 1.0, 1), vmath.vector4(0.60, 0.85, 1.0, 1), vmath.vector4(0.90, 0.60, 1.0, 1), vmath.vector4(1.0, 0.90, 0.40, 1) },
	-- T12: Legendary sun & solar crimson
	{ vmath.vector4(1.0, 0.70, 0.20, 1), vmath.vector4(1.0, 0.90, 0.35, 1), vmath.vector4(1.0, 0.30, 0.15, 1), vmath.vector4(1, 1, 1, 1) },
}

local function get_hit_palette(tier, is_player, is_fire, is_rage, is_boss)
	if is_boss then return BOSS_PALETTE end
	if is_fire then return FIRE_PALETTE end
	if is_rage then return RAGE_PALETTE end
	local idx = (((tier or 1) - 1) % #TIER_HIT_PALETTES) + 1
	return TIER_HIT_PALETTES[idx]
end

-- Multi-colored directional or radial needle sparks
local function hit_sparks(pos, n, palette, dir_angle, spread, dmin, dmax, scale, dur)
	if not palette or #palette == 0 then return end
	spread = spread or (math.pi * 2)
	scale = scale or 0.8
	dur = dur or 0.15
	local n_colors = #palette

	for i = 1, n do
		local a
		if dir_angle then
			a = dir_angle + (math.random() - 0.5) * spread
		else
			a = (i / n) * math.pi * 2 + (math.random() - 0.5) * 0.6
		end
		local d = dmin + math.random() * (dmax - dmin)
		local tint = palette[((i - 1) % n_colors) + 1]
		local s0 = scale * (0.85 + math.random() * 0.5)

		fx(pos, {
			anim = "fx_spark",
			tint = tint,
			rot = a,
			s0 = s0 * 1.35,
			sy0 = s0 * 0.40,
			s1 = 0.05,
			sy1 = 0.05,
			dur = dur * (0.85 + math.random() * 0.35),
			to = vmath.vector3(pos.x + math.cos(a) * d, pos.y + math.sin(a) * d, 0),
			z = 0.72,
		})
	end
end

local function ring(pos, tint, s0, s1, dur, delay)
	fx(pos, { anim = "fx_ring", tint = tint, s0 = s0, s1 = s1, dur = dur, delay = delay, z = 0.55 })
end

local function puff(pos, tint, s0, s1, dur)
	fx(pos, { anim = "fx_puff", tint = tint, s0 = s0, s1 = s1, dur = dur, z = 0.5 })
end

local function coin_pop(pos, n)
	sound.play("coin", 0.55)
	for _ = 1, n do
		if frame_budget.coin >= MAX_COINS_PER_FRAME then return end
		frame_budget.coin = frame_budget.coin + 1
		local to = vmath.vector3(pos.x + (math.random() - 0.5) * 26, pos.y + 18 + math.random() * 16, 0)
		fx(pos, { anim = "coin", s0 = 0.18, s1 = 0.23, dur = 0.5, to = to, move_ease = go.EASING_OUTBACK, z = 0.8 })
	end
end

local function team_tint(team, a)
	if team == config.TEAM_ENEMY then
		return vmath.vector4(1.0, 0.45, 0.35, a or 1)
	end
	return vmath.vector4(0.45, 0.8, 1.0, a or 1)
end

local EFFECTS = {}

EFFECTS.merge = function(pos, extra)
	local tier = extra and extra.tier or 2
	local tint = config.get_tier_color(tier)
	sound.play("merge", 0.85, 0.95 + (tier % 12) * 0.04)
	puff(pos, vmath.vector4(1, 1, 1, 0.9), 0.6, 2.2, 0.22)
	ring(pos, vmath.vector4(tint.x, tint.y, tint.z, 1), 0.25, 1.7, 0.4)
	sparks(pos, 14, GOLD, tint, 25, 62, 0.9, 0.38)
	shake(0.004, 0.12)
end

EFFECTS.new_tier = function(pos, extra)
	sound.play("new_tier", 0.95)
	local tint = config.get_tier_color(extra and extra.tier or 2)
	ring(pos, vmath.vector4(1, 1, 1, 1), 0.35, 2.8, 0.55)
	ring(pos, vmath.vector4(tint.x, tint.y, tint.z, 1), 0.25, 2.2, 0.6, 0.08)
	sparks(pos, 28, GOLD, WHITE, 40, 110, 1.25, 0.7)
	sparks(pos, 16, tint, GOLD, 25, 80, 0.95, 0.5)
	shake(0.012, 0.24)
end

EFFECTS.lucky = function(pos)
	sound.play("coin", 0.75, 1.2)
	ring(pos, GOLD, 0.3, 1.9, 0.45)
	sparks(pos, 12, GOLD, WHITE, 25, 60, 1.0, 0.45)
	coin_pop(pos, 3)
end

EFFECTS.sell = function(pos)
	sound.play("coin", 0.75)
	sparks(pos, 10, GOLD, vmath.vector4(1, 0.95, 0.6, 1), 18, 45, 0.7, 0.3)
	coin_pop(pos, 3)
	shake(0.004, 0.08)
end

EFFECTS.crate_open = function(pos, extra)
	sound.play("merge", 0.75, 1.2)
	local tint = (extra and extra.golden) and GOLD or vmath.vector4(0.95, 0.75, 0.45, 1)
	puff(pos, vmath.vector4(1, 0.95, 0.8, 0.9), 0.5, 2.0, 0.3)
	sparks(pos, 12, tint, WHITE, 20, 55, 0.9, 0.4)
	shake(0.005, 0.1)
end

EFFECTS.clash = function(pos, extra)
	sound.play("slash", 0.85)
	sound.play("hit", 0.8)
	local tier = extra and extra.tier or 1
	puff(pos, vmath.vector4(0.9, 0.85, 0.75, 0.75), 0.6, 2.6, 0.4)
	ring(pos, WHITE, 0.2, 1.8, 0.28)
	ring(pos, GOLD, 0.15, 1.4, 0.32, 0.04)

	local clash_palette = {
		vmath.vector4(0.2, 0.8, 1.0, 1),
		vmath.vector4(1.0, 0.3, 0.35, 1),
		GOLD,
		WHITE,
		vmath.vector4(1.0, 0.6, 0.15, 1),
	}
	hit_sparks(pos, 14, clash_palette, nil, nil, 20, 55, 0.95, 0.30)
	shake(math.min(0.012, 0.005 + tier * 0.0006), 0.14)
end

EFFECTS.squad_death = function(pos, extra)
	local tier = extra and extra.tier or 1
	local big = extra and extra.is_boss
	local tint = team_tint(extra and extra.team)
	puff(pos, vmath.vector4(tint.x, tint.y, tint.z, 0.75), 0.8, big and 4.0 or 2.6, 0.45)
	ring(pos, vmath.vector4(1, 1, 1, 0.9), 0.3, big and 3.2 or 2.0, 0.4)
	sparks(pos, big and 20 or 10, tint, GOLD, 20, big and 90 or 55, 0.9, 0.45)
	shake(big and 0.016 or math.min(0.01, 0.003 + tier * 0.0005), big and 0.3 or 0.14)
end

EFFECTS.arrow_hit = function(pos, extra)
	if frame_budget.arrow >= MAX_ARROW_FX_PER_FRAME then return end
	frame_budget.arrow = frame_budget.arrow + 1
	sound.play("hit", 0.65)

	local fire = extra and extra.fire
	local is_player = (extra and extra.team == config.TEAM_PLAYER)
	local tier = extra and extra.tier or 1

	local palette
	if fire then
		palette = FIRE_PALETTE
	elseif is_player then
		palette = PLAYER_ARROW_PALETTE
	else
		palette = ENEMY_ARROW_PALETTE
	end

	local main_tint = palette[1]
	puff(pos, vmath.vector4(main_tint.x, main_tint.y, main_tint.z, fire and 0.9 or 0.75), 0.22, fire and 1.1 or 0.75, 0.18)

	-- Multi-colored needle sparks in 360-degree burst
	local n_sparks = fire and 7 or 4
	hit_sparks(pos, n_sparks, palette, nil, nil, 8, fire and 32 or 22, fire and 0.85 or 0.65, fire and 0.20 or 0.15)

	-- Impact starburst flash
	fx(pos, {
		anim = "fx_spark",
		tint = fire and vmath.vector4(1, 0.95, 0.5, 1) or WHITE,
		s0 = fire and 0.65 or 0.45,
		s1 = 0.08,
		dur = 0.10,
		z = 0.74,
	})

	-- Fire shockwave ring
	if fire then
		fx(pos, {
			anim = "fx_ring",
			tint = vmath.vector4(1.0, 0.55, 0.1, 0.85),
			s0 = 0.15,
			s1 = 0.55,
			dur = 0.16,
			z = 0.62,
		})
	end
end

EFFECTS.slash = function(from_pos, target_pos, sq, tgt)
	if frame_budget.slash >= MAX_SLASH_PER_FRAME then return end
	frame_budget.slash = frame_budget.slash + 1
	sound.play("slash", 0.65)

	local tier = sq and sq.tier or 1
	local is_player = (not sq) or (sq.team == config.TEAM_PLAYER)
	local is_fire = sq and sq.has_fire
	local is_rage = sq and sq.has_rage
	local is_boss = sq and sq.is_boss

	local boost = battle_state.get_rage_drum_level()
	if boost > 0.4 then is_rage = true end

	-- Calculate strike vector
	local dx = target_pos.x - from_pos.x
	local dy = target_pos.y - from_pos.y
	local dist = math.sqrt(dx * dx + dy * dy)
	local attack_angle = (dist > 0.1) and math.atan2(dy, dx) or (math.pi * 0.5)

	-- Multi-slash for larger squads clashing
	local alive = sq and sq.alive_units or 1
	local n_slashes = (alive >= 12 and frame_budget.slash < MAX_SLASH_PER_FRAME) and 2 or 1

	local palette = get_hit_palette(tier, is_player, is_fire, is_rage, is_boss)
	local primary_color = palette[1]
	local s_base = 0.36 + math.min(0.36, tier * 0.024)
	if is_boss then s_base = s_base * 1.4 end

	for s_idx = 1, n_slashes do
		if s_idx > 1 then frame_budget.slash = frame_budget.slash + 1 end
		local t_contact = 0.70 + (math.random() - 0.5) * 0.16
		local px = from_pos.x + dx * t_contact + (math.random() - 0.5) * 16
		local py = from_pos.y + dy * t_contact + (math.random() - 0.5) * 16
		local hit_pos = vmath.vector3(px, py, 0)
		local slash_angle = attack_angle - math.pi * 0.5 + (math.random() - 0.5) * 0.9

		-- 1. Outer colored blade wave
		fx(hit_pos, {
			anim = "fx_slash",
			tint = vmath.vector4(primary_color.x, primary_color.y, primary_color.z, 0.95),
			rot = slash_angle,
			s0 = s_base,
			s1 = s_base * 1.35,
			sy0 = s_base * 0.85,
			sy1 = s_base * 0.22,
			dur = 0.13,
			z = 0.65,
		})

		-- 2. Inner brilliant core for higher tiers or crits
		if tier >= 2 or is_boss or is_fire or is_rage then
			fx(hit_pos, {
				anim = "fx_slash",
				tint = WHITE,
				rot = slash_angle,
				s0 = s_base * 0.65,
				s1 = s_base * 0.92,
				sy0 = s_base * 0.45,
				sy1 = s_base * 0.12,
				dur = 0.10,
				z = 0.66,
			})
		end

		-- 3. Directional multi-colored needle sparks spraying outwards
		local n_sparks = math.min(7, 3 + math.floor(tier * 0.25))
		hit_sparks(hit_pos, n_sparks, palette, attack_angle, math.pi * 0.65, 14, 34 + tier * 1.2, 0.72 + tier * 0.02, 0.15)

		-- 4. Starburst flash at impact center
		fx(hit_pos, {
			anim = "fx_spark",
			tint = (math.random() < 0.5) and WHITE or palette[2],
			s0 = 0.42 + math.min(0.28, tier * 0.02),
			s1 = 0.08,
			dur = 0.09,
			z = 0.72,
		})

		-- 5. Impact micro shockwave on high tiers, buffs, or crits
		if tier >= 3 or is_boss or is_fire or is_rage or math.random() < 0.35 then
			fx(hit_pos, {
				anim = "fx_ring",
				tint = vmath.vector4(primary_color.x, primary_color.y, primary_color.z, 0.8),
				s0 = 0.08,
				s1 = 0.30 + math.min(0.28, tier * 0.022),
				dur = 0.13,
				z = 0.60,
			})
		end
	end
end

EFFECTS.shield_hit = function(pos, extra)
	if frame_budget.hit >= MAX_HIT_FX_PER_FRAME then return end
	frame_budget.hit = frame_budget.hit + 1
	sound.play("hit", 0.75, 1.25)
	ring(pos, vmath.vector4(0.2, 0.85, 1.0, 0.9), 0.1, 0.65, 0.16)
	hit_sparks(pos, 6, SHIELD_PALETTE, nil, nil, 10, 30, 0.7, 0.16)
end

EFFECTS.unit_death_burst = function(pos, sq)
	if frame_budget.hit >= MAX_HIT_FX_PER_FRAME then return end
	frame_budget.hit = frame_budget.hit + 1
	local tier = sq and sq.tier or 1
	local is_player = (sq and sq.team == config.TEAM_PLAYER)
	local palette = get_hit_palette(tier, is_player, false, false, sq and sq.is_boss)
	puff(pos, vmath.vector4(palette[1].x, palette[1].y, palette[1].z, 0.65), 0.25, 0.85, 0.20)
	hit_sparks(pos, 5, palette, nil, nil, 8, 26, 0.6, 0.16)
end

EFFECTS.drum_tap = function(pos)
	sound.play("hit", 0.45, 1.35)
	ring(pos, vmath.vector4(1, 0.8, 0.3, 0.8), 0.15, 0.9, 0.22)
	sparks(pos, 4, vmath.vector4(1, 0.6, 0.15, 1), GOLD, 10, 26, 0.5, 0.2)
end

EFFECTS.battle_start = function(pos)
	ring(pos, vmath.vector4(1, 1, 1, 0.9), 0.4, 5.0, 0.5)
	shake(0.006, 0.15)
end

-- Kicked-up dust under marching squads (drawn below the warriors)
local function dust(pos, count)
	if frame_budget.dust >= MAX_DUST_PER_FRAME then return end
	frame_budget.dust = frame_budget.dust + 1
	local s = 0.5 + math.min(0.8, count / 40)
	fx(vmath.vector3(pos.x + (math.random() - 0.5) * 14, pos.y - 8, 0), {
		anim = "fx_puff", tint = vmath.vector4(0.92, 0.84, 0.66, 0.42),
		s0 = s * 0.5, s1 = s * 1.4, dur = 0.5, z = -0.03,
		to = vmath.vector3(pos.x + (math.random() - 0.5) * 20, pos.y - 2, 0),
	})
end

local function cheer(list)
	for _, sq in ipairs(list) do
		if sq.is_alive and sq.go_id then msg.post(sq.go_id, "cheer") end
	end
end

EFFECTS.victory_burst = function()
	sound.play("victory", 0.9)
	cheer(battle_state.get_player_squads())
	for i = 1, 6 do
		local p = vmath.vector3(110 + math.random() * 180, 360 + math.random() * 170, 0)
		ring(p, GOLD, 0.2, 1.6, 0.5, i * 0.06)
		sparks(p, 6, GOLD, WHITE, 20, 50, 0.9, 0.5)
	end
end

EFFECTS.defeat_burst = function(pos)
	sound.play("defeat", 0.9)
	cheer(battle_state.get_enemy_squads())
	ring(pos, vmath.vector4(1, 0.3, 0.3, 0.8), 0.4, 4.0, 0.6)
	shake(0.01, 0.25)
end

local function play_effect(effect_type, pos, extra)
	local f = EFFECTS[effect_type]
	if f then f(pos, extra) end
end

-- =============================================================================
-- VIEW QUEUE (factory/go calls must run inside this script's context)
-- =============================================================================
local function queue(fn)
	action_queue[#action_queue + 1] = fn
end

local function process_queue()
	local i = 1
	while i <= #action_queue do
		action_queue[i]()
		i = i + 1
	end
	action_queue = {}
end

local function setup_msg(sq)
	return {
		team = sq.team,
		unit_type = sq.unit_type,
		tier = sq.tier,
		unit_count = sq.unit_count,
		pos = sq.current_pos,
		is_merge = sq.is_merge,
		is_boss = sq.is_boss,
	}
end

local function delete_go(go_id, duration, to_pos)
	if not (go_id and go.exists(go_id)) then return end
	go.cancel_animations(go_id, "scale")
	go.cancel_animations(go_id, "position")
	if to_pos then
		go.animate(go_id, "position", go.PLAYBACK_ONCE_FORWARD, to_pos, go.EASING_INQUAD, duration)
	end
	go.animate(go_id, "scale", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(0.01, 0.01, 1), go.EASING_INBACK, duration, 0, function()
		if go.exists(go_id) then go.delete(go_id, true) end
	end)
end

local function set_field_items_visible(self, visible)
	local cmd = visible and "show" or "hide"
	local dur = visible and 0.22 or 0.18
	for i = 1, #self.cells do
		msg.post(self.cells[i], cmd, { duration = dur })
	end
	for _, c in ipairs(battle_state.get_crates()) do
		if c.go_id then msg.post(c.go_id, cmd, { duration = dur }) end
	end
	for _, c in ipairs(battle_state.get_cards()) do
		if c.go_id then msg.post(c.go_id, cmd, { duration = dur }) end
	end
end

local function spawn_grid_cells(self)
	self.cells = {}
	for _, team in ipairs({ config.TEAM_PLAYER, config.TEAM_ENEMY }) do
		for r = 1, config.GRID_ROWS do
			for c = 1, config.GRID_COLS do
				local pos = grid.get_cell_pos(team, r, c)
				pos.z = -0.1
				table.insert(self.cells, factory.create("#cell_factory", pos, nil, { team = hash(team) }))
			end
		end
	end
end

local function make_handlers(self)
	return {
		spawn_squad = function(sq)
			queue(function()
				if not sq.is_alive then return end
				if sq.go_id and go.exists(sq.go_id) then go.delete(sq.go_id, true) end
				sq.go_id = factory.create("#bunch_factory", vmath.vector3(sq.current_pos.x, sq.current_pos.y, 0))
				msg.post(sq.go_id, "setup", setup_msg(sq))
				sq.is_merge = nil
			end)
		end,

		refresh_squad = function(sq)
			if sq.go_id then
				msg.post(sq.go_id, "setup", setup_msg(sq))
				sq.is_merge = nil
			end
		end,

		despawn_squad = function(sq, reason)
			local id = sq.go_id
			sq.go_id = nil
			if not id then return end
			queue(function()
				if reason == "remove" then
					if go.exists(id) then go.delete(id, true) end
				elseif reason == "merge" and sq.merge_to then
					-- both squads get pulled into the merge cell
					local to = vmath.vector3(sq.merge_to.x, sq.merge_to.y, 0.5)
					delete_go(id, 0.14, to)
				else
					delete_go(id, reason == "dead" and 0.18 or 0.1)
				end
			end)
		end,

		update_squad = function(sq)
			if not sq.go_id then return end
			-- face the current target (sprites look up at angle 0)
			local face
			local tgt = sq.target
			if tgt and tgt.is_alive then
				face = math.atan2(tgt.current_pos.y - sq.current_pos.y, tgt.current_pos.x - sq.current_pos.x) - math.pi * 0.5
			end
			msg.post(sq.go_id, "update_visual", { pos = sq.current_pos, alive_units = sq.alive_units, face = face })

			local p = sq.current_pos
			if sq.dust_x then
				local dx, dy = p.x - sq.dust_x, p.y - sq.dust_y
				if dx * dx + dy * dy > DUST_STEP2 then
					sq.dust_x, sq.dust_y = p.x, p.y
					local at, n = vmath.vector3(p), sq.alive_units
					queue(function() dust(at, n) end)
				end
			else
				sq.dust_x, sq.dust_y = p.x, p.y
			end
		end,

		replenish_squad = function(sq)
			if sq.go_id then msg.post(sq.go_id, "replenish", { pos = sq.home_pos }) end
		end,

		snap_squad = function(sq)
			if sq.go_id then msg.post(sq.go_id, "snap", { pos = sq.home_pos }) end
		end,

		snap_item = function(item)
			if item.go_id then msg.post(item.go_id, "snap", { pos = item.home_pos }) end
		end,

		damage_squad = function(sq, amount, killed, hit_x, hit_y)
			if sq.go_id then msg.post(sq.go_id, "hit") end
			if killed and killed > 0 then
				local p = (hit_x and hit_y) and vmath.vector3(hit_x, hit_y, 0) or vmath.vector3(sq.current_pos)
				if sq.team == config.TEAM_ENEMY then
					queue(function() coin_pop(p, 1) end)
				end
				queue(function() EFFECTS.unit_death_burst(p, sq) end)
			end
		end,

		attack_squad = function(sq, tgt)
			if sq.go_id then msg.post(sq.go_id, "attack", { target_pos = tgt.current_pos }) end
			if sq.unit_type == config.UNIT_MELEE then
				local from, to = vmath.vector3(sq.current_pos), vmath.vector3(tgt.current_pos)
				queue(function() EFFECTS.slash(from, to, sq, tgt) end)
			end
		end,

		squad_buff = function(sq, buff, on)
			if sq.go_id then msg.post(sq.go_id, "buff", { buff = buff, on = on }) end
		end,

		play_effect = function(effect_type, pos, extra)
			local p = pos and vmath.vector3(pos) or vmath.vector3(200, 322, 0)
			queue(function() play_effect(effect_type, p, extra) end)
		end,

		spawn_card = function(card)
			queue(function()
				if card.go_id and go.exists(card.go_id) then go.delete(card.go_id) end
				card.go_id = factory.create("#card_factory", card.home_pos)
				msg.post(card.go_id, "setup", { card_type = card.card_type, home_pos = card.home_pos })
			end)
		end,

		despawn_card = function(card)
			local id = card.go_id
			card.go_id = nil
			if id then msg.post(id, "consume") end
		end,

		spawn_crate = function(crate)
			queue(function()
				if crate.go_id and go.exists(crate.go_id) then go.delete(crate.go_id) end
				crate.go_id = factory.create("#crate_factory", crate.home_pos)
				msg.post(crate.go_id, "setup", { home_pos = crate.home_pos, golden = crate.is_golden })
			end)
		end,

		despawn_crate = function(crate, callback)
			local id = crate.go_id
			crate.go_id = nil
			if id then msg.post(id, "crack") end
			if callback then
				queue(function() timer.delay(0.28, false, callback) end)
			end
		end,

		sell_item = function(item, pos)
			local id = item.go_id
			item.go_id = nil
			queue(function() delete_go(id, 0.14, vmath.vector3(pos.x, pos.y, 0.7)) end)
		end,

		phase_changed = function(phase)
			queue(function()
				if phase == config.PHASE_BATTLE then
					set_field_items_visible(self, false)
				elseif phase == config.PHASE_PREP then
					set_field_items_visible(self, true)
				end
			end)
		end,

		level_changed = function(level)
			queue(function()
				local tint = config.get_chapter_tint(levels.get_chapter(level))
				go.animate("#board_bg", "tint", go.PLAYBACK_ONCE_FORWARD, tint, go.EASING_INOUTQUAD, 0.6)
			end)
		end,
	}
end

-- Debug autoplay for smoke tests: dmengine --config=merge.autoplay=1 [--config=merge.fresh=1]
local function autoplay_tick(self)
	local phase = battle_state.get_phase()
	if phase == config.PHASE_PREP then
		local crates = battle_state.get_crates()
		if #crates > 0 then battle_state.open_crate(crates[1]) return end
		if battle_state.auto_merge() then return end
		if battle_state.buy_unit(math.random() < 0.6 and config.UNIT_MELEE or config.UNIT_ARCHER) then return end
		battle_state.start_battle()
	elseif phase == config.PHASE_BATTLE then
		battle_state.tap_battle_drum(vmath.vector3(150 + math.random() * 100, 250, 0))
	end
end

function init(self)
	self.autoplay = sys.get_config_int("merge.autoplay", 0) == 1
	self.autoplay_timer = 1.0
	go.set("#board_bg", "tint", vmath.vector4(1, 1, 1, 1))
	spawn_grid_cells(self)
	msg.post("/camera#script", "set_automatic_zoom", { enabled = true })

	battle_state.set_view_handlers(make_handlers(self))
	init_fx()

	local fresh = sys.get_config_int("merge.fresh", 0) == 1
	local debug_level = sys.get_config_int("merge.start_level", 0)
	if debug_level > 1 then
		battle_state.debug_setup(debug_level)
	elseif fresh or not battle_state.load_game() then
		battle_state.start_level(1)
	else
		battle_state.start_level(battle_state.get_current_level(), false, true)
	end
	process_queue()
end

function final(self)
	for i = 1, #self.cells do
		if go.exists(self.cells[i]) then go.delete(self.cells[i]) end
	end
	self.cells = {}
	for i = 1, #fx_pool do
		if go.exists(fx_pool[i].id) then go.delete(fx_pool[i].id) end
	end
	fx_pool = {}
end

function update(self, dt)
	now = now + dt
	frame_budget.slash, frame_budget.coin, frame_budget.arrow, frame_budget.dust, frame_budget.hit = 0, 0, 0, 0, 0
	process_queue()
	battle_state.update_battle(dt)
	-- Light continuous rumble while the tap boost is on
	local boost = battle_state.get_rage_drum_level()
	if boost > 0.05 then
		now_shake = (now_shake or 0) - dt
		if now_shake <= 0 then
			now_shake = 0.07
			shake(0.0015 + boost * 0.0025, 0.09)
		end
	end
	if self.autoplay then
		local t = socket.gettime()
		self.perf_start = self.perf_start or t
		self.perf_n = (self.perf_n or 0) + 1
		if t - self.perf_start >= 5 then
			print(string.format("[perf] real_fps=%.1f level=%d phase=%s", self.perf_n / (t - self.perf_start), battle_state.get_current_level(), battle_state.get_phase()))
			self.perf_start, self.perf_n = t, 0
		end
		if battle_state.get_phase() ~= self.autoplay_phase then
			self.autoplay_phase = battle_state.get_phase()
			self.autoplay_timer = 2.5
		end
		self.autoplay_timer = self.autoplay_timer - dt
		if self.autoplay_timer <= 0 then
			local ph = battle_state.get_phase()
			self.autoplay_timer = (ph == config.PHASE_BATTLE) and 0.15 or ((ph == config.PHASE_PREP) and 0.3 or 1.5)
			autoplay_tick(self)
		end
	end
	process_queue()
end
