	vmath.vector4(1.0, 0.50, 0.08, 1), -- Flame orange
	vmath.vector4(1.0, 0.85, 0.18, 1), -- Sun yellow
	vmath.vector4(1.0, 0.18, 0.25, 1), -- Ember red
	vmath.vector4(1.0, 0.98, 0.80, 1), -- White hot
}

