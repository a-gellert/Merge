	vmath.vector4(1.0, 0.20, 0.45, 1), -- Electric crimson
	vmath.vector4(1.0, 0.82, 0.20, 1), -- Shock gold
	vmath.vector4(0.85, 0.25, 1.0, 1), -- Arcane violet
	vmath.vector4(1.0, 1.0, 1.0, 1),   -- Pure white
}

