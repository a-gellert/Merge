	vmath.vector4(0.75, 0.15, 1.0, 1), -- Void purple
	vmath.vector4(1.0, 0.20, 0.30, 1), -- Blood ruby
	vmath.vector4(1.0, 0.75, 0.15, 1), -- Corrupt gold
