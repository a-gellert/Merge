-- View bridge for battle_state + the FX library (pooled sprites, no per-effect scripts).
local config = require("main.modules.config")
local grid = require("main.modules.grid")
local levels = require("main.modules.levels")
local battle_state = require("main.modules.battle_state")
local sound = require("main.modules.sound")

local camera = nil
pcall(function() camera = require("orthographic.camera") end)
local CAMERA_ID = hash("/camera")

local FX_POOL_SIZE = 280
local MAX_SLASH_PER_FRAME = 6
local MAX_COINS_PER_FRAME = 4
local MAX_ARROW_FX_PER_FRAME = 8
local MAX_HIT_FX_PER_FRAME = 12
local MAX_DUST_PER_FRAME = 4
local DUST_STEP2 = 14 * 14 -- a dust puff every 14 px of marching

local action_queue = {}
local fx_pool = {}
local fx_cursor = 1
local now = 0
local now_shake = 0
local frame_budget = { slash = 0, coin = 0, arrow = 0, dust = 0, hit = 0 }

local GOLD = vmath.vector4(1.0, 0.84, 0.25, 1)
local WHITE = vmath.vector4(1, 1, 1, 1)

-- =============================================================================
-- FX
-- =============================================================================
local function init_fx()
	fx_pool = {}
	for i = 1, FX_POOL_SIZE do
		local id = factory.create("#effect_factory", vmath.vector3(0, -3000, 0))
		fx_pool[i] = { id = id, url = msg.url(nil, id, "sprite"), busy_until = 0, anim = hash("fx_spark") }
		go.set(fx_pool[i].url, "tint", vmath.vector4(1, 1, 1, 0))
	end
end

local function take_fx()
	for _ = 1, FX_POOL_SIZE do
		local f = fx_pool[fx_cursor]
		fx_cursor = fx_cursor % FX_POOL_SIZE + 1
		if f.busy_until <= now then return f end
	end
	return nil
end

-- opts: anim, tint, s0, s1, dur, delay, to (vector3), rot, spin, z, ease, keep_alpha
local function fx(pos, opts)
	local f = take_fx()
	if not f then return end
	local id, url = f.id, f.url
	local dur = opts.dur or 0.3
	local delay = opts.delay or 0
	f.busy_until = now + dur + delay + 0.03

	go.cancel_animations(id, "position")
	go.cancel_animations(id, "scale")
	go.cancel_animations(id, "euler.z")
	go.cancel_animations(url, "tint.w")

	local anim = hash(opts.anim or "fx_spark")
	if anim ~= f.anim then
		f.anim = anim
		sprite.play_flipbook(url, anim)
	end
	go.set_position(vmath.vector3(pos.x, pos.y, opts.z or 0.6), id)
	go.set_rotation(vmath.quat_rotation_z(opts.rot or 0), id)
	local s0 = opts.s0 or 1
	go.set_scale(vmath.vector3(s0, opts.sy0 or s0, 1), id)
	go.set(url, "tint", opts.tint or WHITE)

	local s1 = opts.s1 or s0
	go.animate(id, "scale", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(s1, opts.sy1 or s1, 1), opts.ease or go.EASING_OUTQUAD, dur, delay)
	go.animate(url, "tint.w", go.PLAYBACK_ONCE_FORWARD, 0, go.EASING_INQUAD, dur, delay)
	if opts.to then
		go.animate(id, "position", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(opts.to.x, opts.to.y, opts.z or 0.6), opts.move_ease or go.EASING_OUTQUAD, dur, delay)
	end
	if opts.spin then
		go.animate(id, "euler.z", go.PLAYBACK_ONCE_FORWARD, opts.spin, go.EASING_OUTQUAD, dur, delay)
	end
end

local function shake(intensity, duration)
	if camera and camera.shake then
		camera.shake(CAMERA_ID, intensity, duration)
	end
end

local function sparks(pos, n, tint_a, tint_b, dmin, dmax, scale, dur)
	for i = 1, n do
		local a = (i / n) * math.pi * 2 + (math.random() - 0.5) * 0.5
		local d = dmin + math.random() * (dmax - dmin)
		fx(pos, {
			anim = "fx_spark",
			tint = (i % 2 == 0) and tint_a or (tint_b or tint_a),
			s0 = scale * (0.7 + math.random() * 0.6), s1 = 0.05,
			dur = dur * (0.8 + math.random() * 0.5),
			to = vmath.vector3(pos.x + math.cos(a) * d, pos.y + math.sin(a) * d, 0),
			z = 0.7,
		})
	end
end

-- Multi-color hit spark palettes for vivid combat feedback
