function init(self)
	self.home_pos = go.get_position()
	self.is_cracking = false

	-- Falling from the sky animation with juicy bounce landing
	local landing_pos = vmath.vector3(self.home_pos)
	local sky_pos = vmath.vector3(landing_pos.x, landing_pos.y + 360, landing_pos.z)
	go.set_position(sky_pos)

	go.set_scale(vmath.vector3(0.7, 1.4, 1.0))
	go.animate(".", "position", go.PLAYBACK_ONCE_FORWARD, landing_pos, go.EASING_OUTBOUNCE, 0.52, 0, function()
		-- Squash and stretch upon hitting the ground
		go.set_scale(vmath.vector3(1.35, 0.7, 1.0))
		go.animate(".", "scale", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(1.0, 1.0, 1.0), go.EASING_OUTELASTIC, 0.35)
	end)
end

local function setup(self, data)
	self.home_pos = data.home_pos or go.get_position()
	self.row = data.row
	self.col = data.col
	if data.golden then
		go.set("#sprite", "tint", vmath.vector4(1.0, 0.86, 0.35, 1.0))
		go.animate("#sprite", "tint", go.PLAYBACK_LOOP_PINGPONG, vmath.vector4(1.0, 1.0, 0.75, 1.0), go.EASING_INOUTSINE, 0.6)
	else
		go.set("#sprite", "tint", vmath.vector4(1.0, 1.0, 1.0, 1.0))
	end
	-- Idle wiggle invites a tap
	go.animate(".", "euler.z", go.PLAYBACK_LOOP_PINGPONG, 6, go.EASING_INOUTSINE, 0.35, 0.6)
end

local function crack_open(self)
	if self.is_cracking then return end
	self.is_cracking = true

	-- Rapid vibration shake & white flash
	go.cancel_animations(".", "position")
	go.cancel_animations(".", "scale")
	go.cancel_animations(".", "euler.z")
	go.cancel_animations("#sprite", "tint")
	go.set_rotation(vmath.quat())
	go.set("#sprite", "tint", vmath.vector4(1.0, 1.0, 1.0, 1.0))

	-- Quick violent wobble
	local p = go.get_position()
	go.set_position(vmath.vector3(p.x - 4, p.y, p.z))
	go.animate(".", "position.x", go.PLAYBACK_LOOP_PINGPONG, p.x + 4, go.EASING_INOUTSINE, 0.04)

	go.animate(".", "scale", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(1.25, 1.25, 1.0), go.EASING_OUTBACK, 0.16, 0, function()
		go.cancel_animations(".", "position.x")
		go.set_position(p)
		-- Shatter / pop away
		go.animate(".", "scale", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(0.01, 0.01, 1.0), go.EASING_INBACK, 0.12, 0, function()
			go.delete()
		end)
	end)
end

function on_message(self, message_id, message, sender)
	if message_id == hash("setup") then
		setup(self, message)
	elseif message_id == hash("crack") then
		crack_open(self)
	elseif message_id == hash("snap") then
		local pos = message.pos or self.home_pos
		self.home_pos = vmath.vector3(pos)
		go.cancel_animations(".", "position")
		go.animate(".", "position", go.PLAYBACK_ONCE_FORWARD, pos, go.EASING_OUTQUAD, 0.14)
	elseif message_id == hash("hide") then
		if self.is_cracking then return end
		go.cancel_animations(".", "scale")
		local duration = message.duration or 0.18
		if duration > 0 then
			go.animate(".", "scale", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(0.01, 0.01, 1.0), go.EASING_INBACK, duration, 0, function()
				msg.post("#sprite", "disable")
				msg.post("#shadow", "disable")
			end)
		else
			msg.post("#sprite", "disable")
			msg.post("#shadow", "disable")
			go.set_scale(vmath.vector3(0.01, 0.01, 1.0))
		end
	elseif message_id == hash("show") then
		if self.is_cracking then return end
		msg.post("#sprite", "enable")
		msg.post("#shadow", "enable")
		local duration = message.duration or 0.22
		if duration > 0 then
			go.set_scale(vmath.vector3(0.01, 0.01, 1.0))
			go.animate(".", "scale", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(1.0, 1.0, 1.0), go.EASING_OUTBACK, duration)
		else
			go.set_scale(vmath.vector3(1.0, 1.0, 1.0))
		end
	end
end
