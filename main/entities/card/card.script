local cards = require("main.modules.cards")

function init(self)
	self.card_type = cards.CARD_UPGRADE
	self.home_pos = go.get_position()
	self.is_dragging = false

	-- Pop spawn bounce
	go.set_scale(vmath.vector3(0.1, 0.1, 1.0))
	go.animate(".", "scale", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(1.0, 1.0, 1.0), go.EASING_OUTBACK, 0.28)

	-- Subtle pulsing glow in background
	go.animate("#glow", "scale", go.PLAYBACK_LOOP_PINGPONG, vmath.vector3(1.5, 1.5, 1.0), go.EASING_INOUTSINE, 1.2)
end

local function setup(self, data)
	self.card_type = data.card_type or cards.CARD_UPGRADE
	self.home_pos = data.home_pos or go.get_position()
	self.row = data.row
	self.col = data.col

	local anim_name = "card_" .. self.card_type
	sprite.play_flipbook("#sprite", anim_name)

	local info = cards.CARD_INFO[self.card_type]
	if info and info.glow_color then
		local c = info.glow_color
		go.set("#glow", "tint", vmath.vector4(c.x, c.y, c.z, 0.35))
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("setup") then
		setup(self, message)
	elseif message_id == hash("drag_state") then
		if message.dragging then
			self.is_dragging = true
			go.cancel_animations(".", "scale")
			go.set(".", "position.z", 10.0)
			go.animate(".", "scale", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(1.22, 1.22, 1.0), go.EASING_OUTBACK, 0.12)
			local info = cards.CARD_INFO[self.card_type]
			if info and info.glow_color then
				local c = info.glow_color
				go.set("#glow", "tint", vmath.vector4(c.x, c.y, c.z, 0.7))
			end
		else
			self.is_dragging = false
			go.cancel_animations(".", "scale")
			go.set(".", "position.z", 0.05)
			go.animate(".", "scale", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(1.0, 1.0, 1.0), go.EASING_OUTBACK, 0.12)
			local info = cards.CARD_INFO[self.card_type]
			if info and info.glow_color then
				local c = info.glow_color
				go.set("#glow", "tint", vmath.vector4(c.x, c.y, c.z, 0.35))
			end
		end
	elseif message_id == hash("snap") then
		local pos = message.pos or self.home_pos
		self.home_pos = vmath.vector3(pos)
		go.cancel_animations(".", "position")
		go.animate(".", "position", go.PLAYBACK_ONCE_FORWARD, pos, go.EASING_OUTQUAD, 0.14)
	elseif message_id == hash("consume") then
		-- Flash white, pop up, and shrink away into target
		go.cancel_animations(".", "scale")
		go.cancel_animations(".", "position")
		go.set("#sprite", "tint", vmath.vector4(2.0, 2.0, 2.0, 1.0))
		go.animate(".", "scale", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(1.3, 1.3, 1.0), go.EASING_OUTQUAD, 0.08, 0, function()
			go.animate(".", "scale", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(0.01, 0.01, 1.0), go.EASING_INBACK, 0.14, 0, function()
				go.delete()
			end)
		end)
	end
end
