local druid = require("druid.druid")
local i18n = require("main.modules.i18n")
local config = require("main.modules.config")
local economy = require("main.modules.economy")
local battle_state = require("main.modules.battle_state")
local tutorial = require("main.modules.tutorial")
local poki = require("main.modules.poki")
local grid = require("main.modules.grid")

local function format_number(val)
	val = tonumber(val) or 0
	local sign = val < 0 and "-" or ""
	val = math.abs(val)

	if val < 1000 then
		return sign .. tostring(math.floor(val))
	end

	local units = {
		{ 1e12, "T" },
		{ 1e9, "B" },
		{ 1e6, "M" },
		{ 1e3, "K" },
	}

	for _, unit in ipairs(units) do
		local threshold = unit[1]
		local suffix = unit[2]
		if val >= threshold then
			local num = val / threshold
			if num >= 100 then
				return string.format("%s%d%s", sign, math.floor(num), suffix)
			elseif num >= 10 then
				local str = string.format("%.1f", num)
				str = string.gsub(str, "%.0$", "")
				return sign .. str .. suffix
			else
				local str = string.format("%.2f", num)
				str = string.gsub(str, "0+$", "")
				str = string.gsub(str, "%.$", "")
				return sign .. str .. suffix
			end
		end
	end

	return sign .. tostring(math.floor(val))
end

local function update_economy_display(coins, cost)
	gui.set_text(gui.get_node("txt_coins"), format_number(coins))
	local buy_label = i18n.get("BUY") .. " " .. format_number(cost)
	gui.set_text(gui.get_node("txt_buy"), buy_label)

	local btn_node = gui.get_node("btn_buy")
	if coins >= cost then
		gui.set_color(btn_node, vmath.vector4(0.16, 0.34, 0.65, 1.0))
	else
		gui.set_color(btn_node, vmath.vector4(0.25, 0.28, 0.35, 0.8))
	end

	local btn_rew_node = gui.get_node("btn_reward")
	local has_empty = (grid.find_first_empty_player_cell() ~= nil)
	if has_empty and tutorial.is_completed() then
		gui.set_color(btn_rew_node, vmath.vector4(0.12, 0.52, 0.32, 1.0))
	else
		gui.set_color(btn_rew_node, vmath.vector4(0.25, 0.30, 0.28, 0.8))
	end

	local btn_merge_node = gui.get_node("btn_merge")
	if battle_state.can_auto_merge() then
		gui.set_color(btn_merge_node, vmath.vector4(0.52, 0.22, 0.82, 1.0))
	else
		gui.set_color(btn_merge_node, vmath.vector4(0.28, 0.22, 0.35, 0.75))
	end
end

local function update_level_display(lvl)
	gui.set_text(gui.get_node("txt_level"), i18n.get("LEVEL") .. " " .. tostring(lvl))
end

local function stop_hand_animation(self)
	local hand = gui.get_node("hand_pointer")
	gui.cancel_animations(hand, gui.PROP_POSITION)
	gui.cancel_animations(hand, gui.PROP_SCALE)
	gui.set_visible(hand, false)
end

local function update_tutorial_ui(self, step)
	local hand = gui.get_node("hand_pointer")
	local hint = gui.get_node("txt_tutorial_hint")
	stop_hand_animation(self)

	if step == tutorial.STEP_BUY then
		gui.set_visible(hand, true)
		gui.set_position(hand, vmath.vector3(56, 84, 0))
		gui.animate(hand, "position.y", 70, gui.EASING_INOUTSINE, 0.6, 0, nil, gui.PLAYBACK_LOOP_PINGPONG)
		gui.set_text(hint, i18n.get("TUTORIAL_BUY"))
	elseif step == tutorial.STEP_MERGE then
		gui.set_visible(hand, true)
		local p_from = vmath.vector3(120, 250, 0)
		local p_to = vmath.vector3(180, 250, 0)
		gui.set_position(hand, p_from)
		gui.animate(hand, "position", p_to, gui.EASING_INOUTSINE, 0.9, 0, nil, gui.PLAYBACK_LOOP_PINGPONG)
		gui.set_text(hint, i18n.get("TUTORIAL_MERGE"))
	elseif step == tutorial.STEP_BATTLE then
		gui.set_visible(hand, true)
		gui.set_position(hand, vmath.vector3(236, 86, 0))
		gui.animate(hand, "position.y", 72, gui.EASING_INOUTSINE, 0.6, 0, nil, gui.PLAYBACK_LOOP_PINGPONG)
		gui.set_text(hint, i18n.get("TUTORIAL_BATTLE"))
	else
		gui.set_text(hint, "")
	end
end

local function hide_popups()
	local victory_panel = gui.get_node("panel_victory")
	local defeat_panel = gui.get_node("panel_defeat")
	gui.set_enabled(victory_panel, false)
	gui.set_visible(victory_panel, false)
	gui.set_enabled(defeat_panel, false)
	gui.set_visible(defeat_panel, false)
end

local function spawn_flying_coins(self, amount, origin_pos)
	local target_pos = vmath.vector3(32, 566, 0)
	local start_x = 150
	local start_y = 350
	if origin_pos then
		start_x = origin_pos.x or start_x
		start_y = origin_pos.y or start_y
	end

	local count = math.min(10, math.max(3, math.floor(amount / 5)))
	local template = gui.get_node("coin_template")

	for i = 1, count do
		local coin_node = gui.clone(template)
		gui.set_enabled(coin_node, true)
		gui.set_visible(coin_node, true)

		-- Random burst offset from origin
		local angle = math.random() * math.pi * 2
		local burst_radius = math.random(15, 45)
		local burst_x = start_x + math.cos(angle) * burst_radius
		local burst_y = start_y + math.sin(angle) * burst_radius

		gui.set_position(coin_node, vmath.vector3(start_x, start_y, 0))
		gui.set_scale(coin_node, vmath.vector3(0.1, 0.1, 1.0))

		local delay = (i - 1) * 0.05
		-- Initial burst & scale up
		gui.animate(coin_node, "position", vmath.vector3(burst_x, burst_y, 0), gui.EASING_OUTQUAD, 0.22, delay, function()
			-- Fly towards coin balance in top-left
			local fly_duration = 0.45 + math.random() * 0.15
			gui.animate(coin_node, "position", target_pos, gui.EASING_INQUAD, fly_duration, 0, function()
				-- Punch scale on balance icon on impact
				local icon = gui.get_node("icon_coin")
				gui.set_scale(icon, vmath.vector3(1.3, 1.3, 1.0))
				gui.animate(icon, "scale", vmath.vector3(1.0, 1.0, 1.0), gui.EASING_OUTBOUNCE, 0.15)
				gui.delete_node(coin_node)
			end)
		end)
		gui.animate(coin_node, "scale", vmath.vector3(0.9, 0.9, 1.0), gui.EASING_OUTBACK, 0.2, delay)
	end
end

local function on_phase_changed(self, phase)
	local bottom_panel = gui.get_node("panel_bottom")
	local victory_panel = gui.get_node("panel_victory")
	local defeat_panel = gui.get_node("panel_defeat")

	if phase == config.PHASE_PREP then
		gui.set_visible(bottom_panel, true)
		hide_popups()
		update_tutorial_ui(self, tutorial.get_step())
		update_economy_display(economy.get_displayed_coins(), economy.get_buy_cost())
	elseif phase == config.PHASE_BATTLE then
		-- Bottom buttons hide during battle
		gui.set_visible(bottom_panel, false)
		hide_popups()
		stop_hand_animation(self)
		gui.set_text(gui.get_node("txt_tutorial_hint"), "")
	else
		gui.set_visible(bottom_panel, false)
		hide_popups()
		stop_hand_animation(self)
	end
end

function init(self)
	msg.post(".", "acquire_input_focus")
	self.druid = druid.new(self)

	-- Explicitly disable and hide victory/defeat panels on start
	hide_popups()

	-- Localized static texts
	gui.set_text(gui.get_node("txt_battle"), i18n.get("BATTLE"))
	gui.set_text(gui.get_node("txt_reward"), i18n.get("REWARD"))
	gui.set_text(gui.get_node("txt_merge"), i18n.get("AUTO_MERGE"))

	-- Button handlers
	self.btn_buy = self.druid:new_button("btn_buy", function()
		poki.on_player_input()
		hide_popups()
		battle_state.buy_unit()
	end)

	self.btn_merge = self.druid:new_button("btn_merge", function()
		poki.on_player_input()
		hide_popups()
		local merged = battle_state.auto_merge()
		local btn_merge_node = gui.get_node("btn_merge")
		if merged then
			-- Juicy feedback punch
			gui.set_scale(btn_merge_node, vmath.vector3(1.15, 1.15, 1.0))
			gui.animate(btn_merge_node, "scale", vmath.vector3(1.0, 1.0, 1.0), gui.EASING_OUTBOUNCE, 0.22)
			pcall(function()
				local cam = require("orthographic.camera")
				cam.shake(hash("/camera"), 0.005, 0.08)
			end)
		else
			-- Subtle horizontal wobble when nothing can be merged
			gui.animate(btn_merge_node, "position.x", -33, gui.EASING_INOUTSINE, 0.05, 0, function()
				gui.animate(btn_merge_node, "position.x", -41, gui.EASING_INOUTSINE, 0.05, 0, function()
					gui.animate(btn_merge_node, "position.x", -37, gui.EASING_OUTSINE, 0.05)
				end)
			end)
		end
	end)

	self.btn_reward = self.druid:new_button("btn_reward", function()
		poki.on_player_input()
		hide_popups()
		if not tutorial.is_completed() then return end
		if not grid.find_first_empty_player_cell() then return end
		poki.rewarded_break("small", function(success)
			if success then
				battle_state.reward_buy_unit()
			end
		end)
	end)

	self.btn_battle = self.druid:new_button("btn_battle", function()
		poki.on_player_input()
		hide_popups()
		battle_state.start_battle()
	end)

	self.btn_next = self.druid:new_button("btn_next", function()
		poki.on_player_input()
		if self.auto_timer then timer.cancel(self.auto_timer) end
		hide_popups()
		poki.commercial_break(function()
			battle_state.start_level(battle_state.get_current_level() + 1)
		end)
	end)

	self.btn_retry = self.druid:new_button("btn_retry", function()
		poki.on_player_input()
		hide_popups()
		poki.commercial_break(function()
			battle_state.start_level(battle_state.get_current_level())
		end)
	end)

	self.pending_earn_events = {}

	economy.on_earn(function(amount, origin_pos)
		table.insert(self.pending_earn_events, { amount = amount, origin_pos = origin_pos })
	end)

	-- Subscriptions set dirty flag so GUI mutations run strictly in .gui_script update(dt)
	self.dirty_ui = true
	self.last_step = tutorial.get_step()
	self.last_coins = economy.get_displayed_coins()
	self.last_cost = economy.get_buy_cost()
	self.last_level = battle_state.get_current_level()
	self.last_phase = battle_state.get_phase()

	economy.on_change(function()
		self.dirty_ui = true
	end)

	battle_state.on_phase_change(function()
		self.dirty_ui = true
	end)

	battle_state.on_level_change(function()
		self.dirty_ui = true
	end)

	tutorial.on_change(function()
		self.dirty_ui = true
	end)
end

function final(self)
	msg.post(".", "release_input_focus")
	if self.auto_timer then timer.cancel(self.auto_timer) end
	self.druid:final()
end

function update(self, dt)
	self.druid:update(dt)
	economy.update(dt)

	local cur_step = tutorial.get_step()
	local cur_coins = economy.get_displayed_coins()
	local cur_cost = economy.get_buy_cost()
	local cur_level = battle_state.get_current_level()
	local cur_phase = battle_state.get_phase()
	local cur_can_merge = battle_state.can_auto_merge()

	if self.dirty_ui or cur_level ~= self.last_level then
		self.last_level = cur_level
		update_level_display(cur_level)
	end

	if self.dirty_ui or cur_coins ~= self.last_coins or cur_cost ~= self.last_cost or cur_can_merge ~= self.last_can_merge then
		self.last_coins = cur_coins
		self.last_cost = cur_cost
		self.last_can_merge = cur_can_merge
		update_economy_display(cur_coins, cur_cost)
	end

	if self.dirty_ui or cur_step ~= self.last_step then
		self.last_step = cur_step
		update_tutorial_ui(self, cur_step)
	end

	if self.dirty_ui or cur_phase ~= self.last_phase then
		self.last_phase = cur_phase
		on_phase_changed(self, cur_phase)
	end

	self.dirty_ui = false

	-- Drum of Rage visual banner / indicator in battle
	if cur_phase == config.PHASE_BATTLE then
		local hint = gui.get_node("txt_tutorial_hint")
		local is_raging = battle_state.get_rage_drum_active()
		if is_raging then
			if not self.rage_ui_active then
				self.rage_ui_active = true
				self.rage_sway_time = 0
				gui.set_text(hint, i18n.get("DRUM_OF_RAGE"))
				-- Soft semi-transparent amber-gold banner without harsh orange
				gui.set_color(hint, vmath.vector4(1.0, 0.82, 0.35, 0.65))
				gui.set_position(hint, vmath.vector3(0, 160, 0)) -- Shifted up towards top field (y=337.5 + 160 = ~497.5)
				gui.set_scale(hint, vmath.vector3(0.50, 0.50, 1.0))
			end
			-- Continuous smooth sway and subtle floating bounce while active
			self.rage_sway_time = (self.rage_sway_time or 0) + dt
			local sway_angle = math.sin(self.rage_sway_time * 7.5) * 3.5
			local bob_y = 160 + math.sin(self.rage_sway_time * 6.0) * 4.0
			gui.set_rotation(hint, vmath.vector3(0, 0, sway_angle))
			gui.set_position(hint, vmath.vector3(0, bob_y, 0))
		else
			if self.rage_ui_active then
				self.rage_ui_active = false
				gui.set_text(hint, "")
				gui.set_color(hint, vmath.vector4(0.0, 0.95, 0.4, 1.0))
				gui.set_scale(hint, vmath.vector3(0.46, 0.46, 1.0))
				gui.set_rotation(hint, vmath.vector3(0, 0, 0))
				gui.set_position(hint, vmath.vector3(0, 0, 0))
			end
		end
	else
		if self.rage_ui_active then
			self.rage_ui_active = false
			local hint = gui.get_node("txt_tutorial_hint")
			gui.set_rotation(hint, vmath.vector3(0, 0, 0))
			gui.set_position(hint, vmath.vector3(0, 0, 0))
		end
	end

	if self.pending_earn_events and #self.pending_earn_events > 0 then
		while #self.pending_earn_events > 0 do
			local ev = table.remove(self.pending_earn_events, 1)
			spawn_flying_coins(self, ev.amount, ev.origin_pos)
		end
	end
end

function on_message(self, message_id, message, sender)
	self.druid:on_message(message_id, message, sender)
end

function on_input(self, action_id, action)
	if action_id == hash("touch") and action.pressed then
		poki.on_player_input()
	end
	return self.druid:on_input(action_id, action)
end
